# --- Database -------------------------------------------------------------
# Leave empty to use the embedded PGlite database in ./data/pglite (demo mode).
# Set to a Neon pooled connection string for staging/production.
DATABASE_URL=

# --- CMS -------------------------------------------------------------------
# Initial admin account created by the seed on first boot.
ADMIN_EMAIL=admin@tuinen-deridder.be
ADMIN_PASSWORD=DeRidder2026!

# Secret used to sign upload URLs and booking-draft cookies. Change in production.
APP_SECRET=change-me-to-a-long-random-string

# Public origin, used in emails, .ics files, sitemap and Open Graph tags.
PUBLIC_SITE_URL=http://localhost:5173

# Protects /api/cron (reminders + hold cleanup). Call with header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me

# adapter-node (npm start) rejects request bodies over 512 kB by default. Raise it so the
# no-JS photo upload fallbacks (CMS media, booking photos) accept phone photos.
BODY_SIZE_LIMIT=60M
